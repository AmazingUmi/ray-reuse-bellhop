{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug with sanitizers",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RAYREUSE_ENABLE_SANITIZERS": "ON",
        "RAYREUSE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RAYREUSE_ENABLE_SANITIZERS": "OFF",
        "RAYREUSE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "static-analysis",
      "displayName": "AppleClang static analysis",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/static-analysis",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "OFF",
        "RAYREUSE_ENABLE_SANITIZERS": "OFF",
        "RAYREUSE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "package",
      "displayName": "Versioned release package",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/package",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "RAYREUSE_ENABLE_SANITIZERS": "OFF",
        "RAYREUSE_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "package",
      "configurePreset": "package",
      "targets": [
        "package"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
