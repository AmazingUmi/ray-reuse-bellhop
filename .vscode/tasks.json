{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Bellhop",
      "type": "process",
      "command": "/usr/bin/make",
      "args": [
        "bellhop"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Bellhop_origin",
        "env": {
          "PATH": "/opt/homebrew/bin:${env:PATH}"
        }
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
