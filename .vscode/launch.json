{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Bellhop example",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\bin\\bellhop.exe",
      "args": [
        "MunkB_Coh_CervenyC"
