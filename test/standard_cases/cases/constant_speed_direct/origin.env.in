1000.0  1600.0  0.0  1.8  0.0 /
1                       ! NSD
500.0 /                 ! Source depth (m)
21                      ! NRD
400.0  600.0 /          ! Receiver depths (m)
51                      ! NR
0.1  5.0 /              ! Receiver ranges (km)
'CC'                    ! Coherent TL, Cartesian Cerveny beams
@NALPHA@                ! Shared launch-angle count derived from fmax
-5.0  5.0 /             ! Launch angles (degrees)
10.0  1100.0  5.1       ! Step (m), ZBOX (m), RBOX (km)
'MS' 1.0  2.5           ! Standard curvature, epsilon multiplier, Rloop (km)
